# =============================================================================
# BridgeCAD Enterprise Suite — .env.example
# Copy to `.env` and edit before running. Never commit the real .env file.
# =============================================================================

# --- Runtime ------------------------------------------------------------------
ENV=dev
LOG_LEVEL=INFO
TZ=UTC
LANG=en_US.UTF-8

# --- Secrets / Auth -----------------------------------------------------------
APP_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@bridgecad.local

# --- API Gateway --------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS="http://localhost:5173,http://localhost:8501"

# --- Database (Postgres in docker-compose, SQLite in dev default) -------------
DB_DRIVER=postgresql+psycopg      # set to sqlite+aiosqlite for local dev
DB_HOST=localhost
DB_PORT=5432
DB_USER=bridgecad
DB_PASSWORD=bridgecad
DB_NAME=bridgecad
# SQLite fallback (used only when DB_DRIVER=sqlite+aiosqlite):
DB_SQLITE_PATH=./.data/bridgecad.sqlite3
DB_URL_OVERRIDE=""                 # optional 1-shot override

# --- Cache (Redis) ------------------------------------------------------------
CACHE_DRIVER=redis                 # redis | memory
CACHE_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# --- Storage (local disk OR S3) ----------------------------------------------
STORAGE_DRIVER=local               # local | s3
STORAGE_LOCAL_ROOT=./.data/storage
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_KEY=minioadmin
STORAGE_S3_SECRET=minioadmin
STORAGE_S3_BUCKET=bridgecad
STORAGE_S3_PUBLIC_URL_PREFIX=""

# --- Async Workers (arq) -----------------------------------------------------
WORKER_REDIS_URL=redis://localhost:6379/1
WORKER_QUEUE=bridgecad.default
WORKER_CONCURRENCY=4

# --- Observability / OTel ----------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=bridgecad-enterprise
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# --- Auth ---------------------------------------------------------------------
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_TTL_SECONDS=86400
AUTH_API_KEYS_ENABLED=true
AUTH_OAUTH2_ENABLED=false
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""

# --- Integrations -------------------------------------------------------------
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_FROM="no-reply@bridgecad.local"

WEBHOOK_EXPORT_SUCCESS=""
WEBHOOK_EXPORT_FAILURE=""

# --- Feature Flags ------------------------------------------------------------
FEATURE_3D_EXPORT=true
FEATURE_AI_OPTIMIZER=true
FEATURE_BILL_MORTH=true
FEATURE_PLUGIN_MARKET=false
FEATURE_MULTI_TENANT=false
